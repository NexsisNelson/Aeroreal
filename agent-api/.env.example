# Existing API configuration
PORT=3001
MONAD_RPC_URL=https://10143.rpc.thirdweb.com
ZERION_API_KEY=
BLOCKVISION_API_KEY=

# Simulated asset oracle (use the deployer's key and deployed contract addresses).
PRIVATE_KEY=0xYOUR_ORACLE_WALLET_PRIVATE_KEY
COINGECKO_API_KEY=
SIMULATED_BTC_ADDRESS=
SIMULATED_ETH_ADDRESS=
SIMULATED_GOLD_ADDRESS=
SIMULATED_COFFEE_ADDRESS=
