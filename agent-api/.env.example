# Required to enable the CCTP bridge. Keep this secret and never commit .env.
CCTP_BRIDGE_PRIVATE_KEY=0xYOUR_BRIDGE_WALLET_PRIVATE_KEY
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Required for user-created NFT uploads to IPFS.
PINATA_JWT=your_pinata_jwt_here
